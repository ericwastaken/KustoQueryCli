{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LIST_SUBSCRIPTIONS Action Response Data",
  "type": "object",
  "properties": {
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tenant_id",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "is_default": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          }
        }
      }
    },
    "login_required": {
      "type": "boolean"
    },
    "azure_auth_mode": {
      "type": "string",
      "enum": [
        "container_managed",
        "host_shared"
      ]
    },
    "message": {
      "type": "string"
    },
    "requested_subscription_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "account": {
      "type": "object"
    },
    "device_login": {
      "type": "object",
      "properties": {
        "verification_url": {
          "type": "string"
        },
        "device_code": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
