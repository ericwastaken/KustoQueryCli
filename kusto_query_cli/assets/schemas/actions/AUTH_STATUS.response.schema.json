{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AUTH_STATUS Action Response Data",
  "type": "object",
  "required": [
    "authenticated"
  ],
  "properties": {
    "authenticated": {
      "type": "boolean"
    },
    "azure_auth_mode": {
      "type": "string",
      "enum": [
        "container_managed",
        "host_shared"
      ]
    },
    "message": {
      "type": "string"
    },
    "subscription": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "account": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      }
    },
    "proxy_config": {
      "type": "object",
      "required": [
        "proxy_enabled",
        "socks5_proxy",
        "socks5_dns"
      ],
      "properties": {
        "proxy_enabled": {
          "type": "boolean"
        },
        "socks5_proxy": {
          "type": [
            "string",
            "null"
          ]
        },
        "socks5_dns": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
